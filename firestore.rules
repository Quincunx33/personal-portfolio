rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable, hardened primitives
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function isSignedIn() { 
      return request.auth != null; 
    }
    function isVerified() { 
      return isSignedIn() && request.auth.token.email_verified == true; 
    }

    // 2. Statistics collection
    match /stats/{statsDoc} {
      allow read: if true;
      allow create: if true && request.resource.data.visitors is int;
      allow update: if request.resource.data.visitors is int && request.resource.data.visitors == resource.data.visitors + 1;
    }

    // 3. Citizen Profiles
    match /citizens/{citizenId} {
      allow get: if isSignedIn();
      allow create: if isVerified() && citizenId == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.displayName is string;
      allow update, delete: if isVerified() && citizenId == request.auth.uid;
    }
  }
}
