{
  "entities": {
    "Citizen": {
      "title": "Citizen",
      "description": "A signed-in member of the Dumb World with their Google Profile details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Google Auth UID"
        },
        "displayName": {
          "type": "string",
          "description": "Name of the citizen"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image link"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of signup"
        }
      },
      "required": ["uid", "displayName", "joinedAt"]
    },
    "GlobalStats": {
      "title": "Global Stats",
      "description": "Global counters like total website visitors.",
      "type": "object",
      "properties": {
        "visitors": {
          "type": "integer",
          "description": "Dynamic visitor count representing total hits"
        }
      },
      "required": ["visitors"]
    }
  },
  "firestore": {
    "/citizens/{citizenId}": {
      "schema": "Citizen",
      "description": "Profiles of logged-in citizens in Dumb World"
    },
    "/stats/global": {
      "schema": "GlobalStats",
      "description": "Track website dynamic traffic stats"
    }
  }
}
